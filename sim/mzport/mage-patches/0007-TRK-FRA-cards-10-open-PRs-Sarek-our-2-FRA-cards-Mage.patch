@@ -0,0 +1,91 @@
+package org.mage.test.cards.single.fra;
+
+import mage.constants.PhaseStep;
+import mage.constants.Zone;
+import mage.counters.CounterType;
+import org.junit.Test;
+import org.mage.test.player.TestPlayer;
+import org.mage.test.serverside.base.CardTestPlayerBase;
+
+/**
+ * Sanity checks for the two FRA cards implemented locally for lmt-magic's
+ * limited simulation (Jace's Machinations, Seasoned Cryomancer).
+ */
+public class LmtSimCardsTest extends CardTestPlayerBase {
+
+    @Test
+    public void testJacesMachinationsCreatesJaceWithEightLoyalty() {
+        addCard(Zone.HAND, playerA, "Jace's Machinations");
+        addCard(Zone.BATTLEFIELD, playerA, "Island", 3);
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Jace's Machinations");
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertGraveyardCount(playerA, "Jace's Machinations", 1);
+        assertPermanentCount(playerA, "Jace", 1);
+        assertCounterCount(playerA, "Jace", CounterType.LOYALTY, 8);
+    }
+
+    @Test
+    public void testJacesMachinationsLetsJaceActivateOnOpponentsTurn() {
+        addCard(Zone.HAND, playerA, "Jace's Machinations");
+        addCard(Zone.BATTLEFIELD, playerA, "Island", 3);
+        addCard(Zone.LIBRARY, playerA, "Grizzly Bears", 3);
+
+        // cast on the opponent's turn, then use the token's -3 on that same turn
+        castSpell(2, PhaseStep.PRECOMBAT_MAIN, playerA, "Jace's Machinations");
+        waitStackResolved(2, PhaseStep.PRECOMBAT_MAIN);
+        activateAbility(2, PhaseStep.POSTCOMBAT_MAIN, playerA, "-3: Draw a card.");
+
+        setStopAt(2, PhaseStep.END_TURN);
+        execute();
+
+        assertCounterCount(playerA, "Jace", CounterType.LOYALTY, 5);
+        assertHandCount(playerA, 1);
+    }
+
+    @Test
+    public void testSeasonedCryomancerStunsForNonlandDiscards() {
+        skipInitShuffling();            // so it draws the two Bears placed on top
+        addCard(Zone.HAND, playerA, "Seasoned Cryomancer");
+        addCard(Zone.BATTLEFIELD, playerA, "Island", 3);
+        addCard(Zone.LIBRARY, playerA, "Grizzly Bears", 2);
+        addCard(Zone.BATTLEFIELD, playerB, "Silvercoat Lion");
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Seasoned Cryomancer");
+        addTarget(playerA, "Silvercoat Lion");        // up to two targets: tap + stun
+        addTarget(playerA, TestPlayer.TARGET_SKIP);
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertPermanentCount(playerA, "Seasoned Cryomancer", 1);
+        assertHandCount(playerA, 0);
+        assertGraveyardCount(playerA, "Grizzly Bears", 2);
+        assertTapped("Silvercoat Lion", true);
+        assertCounterCount(playerB, "Silvercoat Lion", CounterType.STUN, 1);
+    }
+
+    @Test
+    public void testSeasonedCryomancerNoStunWhenOnlyLandsDiscarded() {
+        skipInitShuffling();
+        addCard(Zone.HAND, playerA, "Seasoned Cryomancer");
+        addCard(Zone.BATTLEFIELD, playerA, "Island", 3);
+        addCard(Zone.LIBRARY, playerA, "Mountain", 2);
+        addCard(Zone.BATTLEFIELD, playerB, "Silvercoat Lion");
+
+        castSpell(1, PhaseStep.PRECOMBAT_MAIN, playerA, "Seasoned Cryomancer");
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.END_TURN);
+        execute();
+
+        assertGraveyardCount(playerA, "Mountain", 2);
+        assertTapped("Silvercoat Lion", false);
+        assertCounterCount(playerB, "Silvercoat Lion", CounterType.STUN, 0);
+    }
+}

+        processMana(mp.getMana(), game, "", parentId);
+
+        List<ConditionalMana> conditionalMana = mp.getConditionalMana();
+        if(conditionalMana != null && !conditionalMana.isEmpty()) {
+            for(ConditionalMana condMana : conditionalMana) {

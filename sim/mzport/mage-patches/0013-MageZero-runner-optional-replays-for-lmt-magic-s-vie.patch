                     game.setStartingPlayerId(playerB.getId());
                 }
             }
+            String recordDir = Config.INSTANCE.logging.recordDir;
+            GameRecorder recorder = recordDir == null ? null : new GameRecorder(game, playerA.getId(), playerB.getId());
             game.start(null);
             boolean playerAWon = playerA.hasWon();
+            if (recorder != null) {
+                String winner = playerA.hasWon() ? "A" : playerB.hasWon() ? "B" : "draw";
+                java.nio.file.Path out = java.nio.file.Paths.get(recordDir,
+                        String.format("G%d_%05d.json.gz", System.currentTimeMillis() / 1000, gameCount.get() + 1));
+                try {
+                    recorder.write(out, java.nio.file.Paths.get(deckA).getFileName().toString(),
+                            java.nio.file.Paths.get(deckB).getFileName().toString(), winner);
+                } catch (IOException e) {
+                    logger.warn("could not write replay " + out + ": " + e);
+                }
+            }
             //merge to the final features
             synchronized (seenFeatures) {
                 seenFeatures.merge(threadEncoderA.featureMap);

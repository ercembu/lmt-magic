     protected int makeChoiceAmount(int min, int max, Game game, Ability source, boolean isManaPay) {
+        if (isMageZeroAgent()) {
+            return makeChoiceAmountMageZero(min, max, game, source, isManaPay);
+        }
+        // fast calc on nothing to choose
+        if (min >= max) {
+            return min;
